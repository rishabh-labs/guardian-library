# Copy to .env locally, or paste these as environment variables in the cloud host.

# --- required ---------------------------------------------------------
ADMIN_PASSWORD=pick-something-long
SECRET_KEY=paste-a-random-40-char-string-here

# --- optional but recommended ----------------------------------------
# Free 10,000 units/day. Catches manager appearances on CNBC-TV18, ET Now,
# podcasts etc. Without it, only the fund houses' own channels are tracked.
# Get one at console.cloud.google.com -> enable "YouTube Data API v3" -> Credentials
YOUTUBE_API_KEY=

# Powers the Analysis tab. Without it the dashboard works but no summaries.
# Get one at console.anthropic.com
ANTHROPIC_API_KEY=
ANALYSIS_MODEL=claude-sonnet-5

# --- tuning -----------------------------------------------------------
POLL_MINUTES=30
BACKFILL_DAYS=90
AUTO_ANALYSE=1
MAX_ANALYSES_PER_RUN=25

# On a cloud host, point this at the mounted persistent disk so the database
# survives redeploys. Leave unset locally.
# DATA_DIR=/data

# --- YouTube transcript proxy (only if transcripts start failing) -----
# Symptom: IpBlocked / RequestBlocked on videos that play fine in a browser.
# YouTube rate-limits per IP and blocks most cloud-provider ranges. Only the
# video summaries are affected; collection and news summaries keep working.
# Either set a Webshare residential proxy...
# WEBSHARE_PROXY_USERNAME=
# WEBSHARE_PROXY_PASSWORD=
# ...or any generic HTTP proxy:
# TRANSCRIPT_PROXY_HTTP=
# TRANSCRIPT_PROXY_HTTPS=
