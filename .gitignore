.env
data/
*.db
*.db-wal
*.db-shm
# ...except the library itself, which the scheduled job commits back. It holds
# last_checked for every source; without it each run would redo the six-month
# backfill and exhaust the YouTube quota.
!data/library.db

# Built by export_static.py and published from the workflow, never committed.
site/
__pycache__/
*.pyc
.venv/
venv/
# No spreadsheets in the repository. The committed database already carries
# every fund and source, so the seed sheet was never actually read - and this
# repository is public, so the raw list of holdings has no business in it.
*.xlsx

# Our own videos. Streamed from disk by the portal, far too big for git, and
# not something to publish - they stay on the machine that serves them.
media/
